From 467efb7a78e4c3737867e1b7ebb97d28f1249e30 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Tue, 25 Aug 2026 18:10:24 +0000
Subject: [PATCH] =?UTF-8?q?fix:=20connexion=20Google=20mobile=20toujours?=
 =?UTF-8?q?=20rejet=C3=A9e=20apr=C3=A8s=20config:cache=20en=20prod?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GoogleAuthController::mobileLogin() appelait env('GOOGLE_WEB_CLIENT_ID')
etc. directement dans le contrôleur. Après php artisan config:cache
(fait en prod), Laravel ne relit plus jamais le .env à l'exécution :
tout appel à env() en dehors de config/*.php renvoie null. Résultat :
$validAudiences devenait [null, null, null], et AUCUN token — même
parfaitement valide — ne pouvait jamais matcher, d'où 'Token non
destiné à cette application' systématique une fois le cache généré.

Confirmé par le débogage : le token reçu avait bien le bon aud
(webClientId compilé dans l'APK), le problème était entièrement
côté serveur.

Fix : ajout de google.web_client_id / android_client_id / ios_client_id
dans config/services.php, et le contrôleur lit maintenant via config()
au lieu de env() — la config reste donc valide même après un futur
config:cache.
---
 app/Http/Controllers/GoogleAuthController.php | 6 +++---
 config/services.php                           | 9 +++++++++
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/app/Http/Controllers/GoogleAuthController.php b/app/Http/Controllers/GoogleAuthController.php
index 40c7539..ee40b81 100644
--- a/app/Http/Controllers/GoogleAuthController.php
+++ b/app/Http/Controllers/GoogleAuthController.php
@@ -109,9 +109,9 @@ public function mobileLogin(Request $request)
         // Vérifie que le token est bien destiné à TON app (évite qu'un token
         // Google d'une autre application ne soit accepté ici)
         $validAudiences = [
-            env('GOOGLE_WEB_CLIENT_ID'),
-            env('GOOGLE_ANDROID_CLIENT_ID'),
-            env('GOOGLE_IOS_CLIENT_ID'),
+            config('services.google.web_client_id'),
+            config('services.google.android_client_id'),
+            config('services.google.ios_client_id'),
         ];
 
         if (!in_array($payload['aud'] ?? null, $validAudiences)) {
diff --git a/config/services.php b/config/services.php
index 540c0a9..e303633 100644
--- a/config/services.php
+++ b/config/services.php
@@ -39,6 +39,15 @@
         'client_id' => env('GOOGLE_CLIENT_ID'),
         'client_secret' => env('GOOGLE_CLIENT_SECRET'),
         'redirect' => env('GOOGLE_REDIRECT_URI'), // ex: http://localhost:8000/api/auth/google/callback
+        // Audiences valides pour la connexion mobile (GoogleAuthController::mobileLogin).
+        // Lues ici via config() plutôt que env() directement dans le contrôleur :
+        // env() en dehors de config/*.php renvoie null dès que php artisan
+        // config:cache a été lancé (le .env n'est alors plus relu du tout) —
+        // c'est ce qui causait "Token non destiné à cette application" pour
+        // TOUT token, même parfaitement valide, une fois le cache généré en prod.
+        'web_client_id' => env('GOOGLE_WEB_CLIENT_ID'),
+        'android_client_id' => env('GOOGLE_ANDROID_CLIENT_ID'),
+        'ios_client_id' => env('GOOGLE_IOS_CLIENT_ID'),
     ],
 
     'fcm' => [
-- 
