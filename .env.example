APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# URL du frontend React (admin) — utilisée pour les redirections OAuth Google web
# et pour construire le callback_url envoyé à FedaPay après paiement.
FRONTEND_URL=http://localhost:5173

# --- Google OAuth (login web + mobile) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# IDs clients OAuth utilisés pour vérifier le id_token envoyé par l'app mobile (Android/iOS)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# --- Firebase Cloud Messaging (réveil de l'app mobile pour un nouveau SMS à envoyer) ---
FCM_SERVER_KEY=

# --- FedaPay (paiement des abonnements, XOF) ---
# Clés disponibles dans le dashboard FedaPay > Développeurs > Clés API
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# sandbox pour les tests, live en production
FEDAPAY_ENVIRONMENT=sandbox
# Clé secrète du endpoint webhook (dashboard FedaPay > Développeurs > Webhooks)
FEDAPAY_WEBHOOK_SECRET=

# --- Google Analytics (GA4) — dashboard super-admin uniquement ---
# Procédure complète dans app/Services/GoogleAnalyticsService.php
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CREDENTIALS_PATH=

# --- MTN SMS v3 API (https://developers.mtn.com/products/sms-v3-api) ---
# Canal de secours utilisé quand aucun téléphone appairé n'est disponible.
# Laisser à false tant que l'app MTN n'est pas approuvée / testée.
MTN_SMS_ENABLED=true
MTN_SMS_BASE_URL=https://api.mtn.com
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token
# Identifiants MTN DE LA PLATEFORME (un seul compte MTN Developer partagé par
# tous les clients) — consumer key/secret de l'app créée sur developers.mtn.com
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
# Short code approuvé par MTN pour ton app (obligatoire)
MTN_SMS_SERVICE_CODE=
# Repli si un client n'a pas encore configuré son propre indicatif pays
# depuis son dashboard (voir organisations.mtn_country_code). Pas de valeur
# globale pour sender_address : chaque client configure le sien.
MTN_SMS_COUNTRY_CODE=229
